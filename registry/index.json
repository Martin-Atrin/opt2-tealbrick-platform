  "harnesses": [
    {
      "id": "tbd-default",
      "kind": "desktop",
      "label": "Teal Brick desktop app",
      "icon": null,
      "authorise": "device_approval",
      "noAgentPath": true,
      "instructions": [
        {
          "title": "Open the desktop app",
          "detail": "Open the Teal Brick desktop app on your Mac and sign in with your Portal account."
        },
        {
          "title": "Approve the agent",
          "detail": "The app opens a Portal page that shows a code. Check that the code matches the app, then select Approve. This connects the app's built-in agent to this workspace."
        },
        {
          "title": "Done",
          "detail": "The agent card turns to connected. Ask the agent in the app; it uses the apps you connect to it on the canvas."
        }
      ]
    },
    {
      "id": "claude-desktop",
      "kind": "desktop",
      "label": "Claude Desktop",
      "icon": null,
      "authorise": "instruction_set",
      "noAgentPath": false,
      "instructions": [
        {
          "title": "Add a custom connector",
          "detail": "In Claude Desktop open Settings, then Connectors, then Add custom connector. Name it Teal Brick and paste this URL.",
          "copy": {
            "kind": "url",
            "value": "{{mcpUrl}}"
          }
        },
        {
          "title": "Connect and approve in Portal",
          "detail": "Select Connect. A browser page from your workspace opens. Select Approve in Portal, choose this agent card and confirm. You return to Claude automatically."
        },
        {
          "title": "If you prefer a code",
          "detail": "On the same page, open 'I have a pairing code' and paste this one-time code (valid 10 minutes).",
          "copy": {
            "kind": "text",
            "value": "{{pairingCode}}"
          }
        },
        {
          "title": "Start a new chat",
          "detail": "Start a new chat so Claude loads the Teal Brick tools and skills. The connector shows only the apps this agent may use."
        }
      ]
    },
    {
      "id": "codex-desktop",
      "kind": "desktop",
      "label": "Codex",
      "icon": null,
      "authorise": "instruction_set",
      "noAgentPath": false,
      "instructions": [
        {
          "title": "Add the MCP server",
          "detail": "Add this server to your Codex configuration file (~/.codex/config.toml), or add a Streamable HTTP MCP server with this URL in the Codex settings.",
          "copy": {
            "kind": "text",
            "value": "[mcp_servers.tealbrick]\nurl = \"{{mcpUrl}}\""
          }
        },
        {
          "title": "Sign in",
          "detail": "Run this command (or select Sign in in the Codex settings). A browser page from your workspace opens: select Approve in Portal and choose this agent card.",
          "copy": {
            "kind": "command",
            "value": "codex mcp login tealbrick"
          }
        },
        {
          "title": "If you prefer a code",
          "detail": "On the same page, open 'I have a pairing code' and paste this one-time code (valid 10 minutes).",
          "copy": {
            "kind": "text",
            "value": "{{pairingCode}}"
          }
        },
        {
          "title": "Start a new session",
          "detail": "Start a new Codex session so it loads the Teal Brick tools."
        }
      ]
    },
    {
      "id": "eve",
      "kind": "agentic_system",
      "label": "Eve agent",
      "icon": null,
      "authorise": "device_approval",
      "noAgentPath": false,
      "instructions": [
        {
          "title": "Install the command line tool",
          "detail": "On the machine that runs the Eve agent, install the tealbrick command line tool from the Teal Brick releases page."
        },
        {
          "title": "Connect the agent",
          "detail": "Run this command and approve the request in the Portal page it shows (one click).",
          "copy": {
            "kind": "command",
            "value": "tealbrick agent login --agent {{agentId}} --harness eve"
          }
        },
        {
          "title": "Use the bridge from Eve",
          "detail": "In the Eve agent, use the package @opt2-tealbrick/harness-eve (connectEveToBridge). It starts the local relay and turns the granted apps into Eve tools."
        }
      ]
    },
    {
      "id": "generic-mcp",
      "kind": "other",
      "label": "Other agent (MCP)",
      "icon": null,
      "authorise": "url",
      "noAgentPath": false,
      "instructions": [
        {
          "title": "Connect the agent machine",
          "detail": "On the agent's machine, install the tealbrick command line tool and run this command. Approve the request in the Portal page it shows.",
          "copy": {
            "kind": "command",
            "value": "tealbrick agent login --agent {{agentId}} --harness generic"
          }
        },
        {
          "title": "Local MCP (stdio)",
          "detail": "Configure your agent with this MCP server command. It runs a local relay that signs in as this agent; all checks run in your workspace bridge.",
          "copy": {
            "kind": "command",
            "value": "tealbrick bridge serve --stdio --agent {{agentId}}"
          }
        },
        {
          "title": "Claude Code",
          "detail": "For Claude Code, add the server with this command.",
          "copy": {
            "kind": "command",
            "value": "claude mcp add --scope user tealbrick -- tealbrick bridge serve --stdio --agent {{agentId}}"
          }
        },
        {
          "title": "Remote MCP (OAuth)",
          "detail": "Harnesses that support remote MCP with OAuth can use this URL instead and approve in Portal.",
          "copy": {
            "kind": "url",
            "value": "{{mcpUrl}}"
          }
        }
      ]
    }
  ]
}
